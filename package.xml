<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>basicmicro_driver</name>
  <version>1.1.0</version>
  <description>ROS2 driver for differential-drive robots on Basicmicro (formerly RoboClaw) motor controllers</description>
  
  <maintainer email="eduardo.salazar@cinvestav.mx">Eduardo</maintainer>
  <license>Apache-2.0</license>
  
  <url type="website">https://github.com/basicmicro/basicmicro_ros2</url>

  <!-- Node -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- The basicmicro library is installed with pip (see README); it has no rosdep key -->

  <!-- Launch file -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
